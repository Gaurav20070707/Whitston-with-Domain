# ============================================================================
# Firebase (client) — Auth + Firestore only
# ============================================================================
# Copy this file to `.env.local` and fill in the values from your Firebase
# project (Project settings → General → Your apps → SDK setup and config).
#
# These are all prefixed with NEXT_PUBLIC_ because the Firebase client SDK
# runs in the browser — none of these values are secret in the way an API
# secret key would be, but Google Sign-In must still be restricted to your
# domain(s) in the Firebase console under Authentication → Settings →
# Authorized domains.
#
# No storage bucket here on purpose — file uploads use Appwrite (below),
# not Firebase Storage, because Firebase Storage requires a billing account
# even on its free tier.
# ============================================================================

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ============================================================================
# Firebase Admin (server-only) — used by the two API routes under
# src/app/api/ to verify a caller's ID token and check /admins/{uid} without
# going through client-side security rules. From Firebase console →
# Project settings → Service accounts → Generate new private key.
#
# NEVER prefix these with NEXT_PUBLIC_ — they must stay server-only.
# ============================================================================

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes and \n escapes exactly as they appear in the downloaded
# JSON key's "private_key" field.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ============================================================================
# Appwrite — file storage for case decks and competition submissions
# ============================================================================
# Free Appwrite Cloud project: https://cloud.appwrite.io (no billing card
# required for the free tier, which is the whole reason this project uses
# it instead of Firebase Storage). Create a project, then ONE Storage
# bucket with permissions "Read: Any" and no other permissions — every
# write goes through the server routes below using the API key, which
# bypasses bucket-level permissions entirely. (The free plan caps you at
# one bucket anyway; that's fine, case decks and submissions share it
# safely since every file gets its own random, unique id.)
#
# API key: project Settings → API keys → Create API key, with the "files.read",
# "files.write", and "files.delete" scopes. Keep it server-only, same as the
# Firebase Admin credentials above.
# ============================================================================

NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_BUCKET_ID="6ab018100003649e09ef"
